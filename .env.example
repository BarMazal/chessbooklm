# Path to local Stockfish executable (optional - if omitted, Lichess Cloud Eval API is used)
STOCKFISH_PATH=

# NotebookLM Configuration (via notebooklm-py)
NOTEBOOKLM_NOTEBOOK_ID=
NOTEBOOKLM_AUTH_TOKEN=

# Optional Gemini API Key (if using fallback)
GEMINI_API_KEY=

# App Server Host & Port
HOST=127.0.0.1
PORT=8000
